# Public site URL used for sitemap, robots, JSON-LD, Origin checks, and Stripe URLs.
# Production currently: https://waterproof-detailing-glove.vercel.app
# When you add a custom domain, update this + the Stripe webhook endpoint URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock | stripe
# Server reads PAYMENT_PROVIDER (and NEXT_PUBLIC_ for checkout UI).
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# Set both to true only when Stripe Checkout should accept real (or test-mode) pre-orders.
# Until then, /api/checkout returns 503 and the checkout UI shows "payments open soon".
PAYMENTS_OPEN=false
NEXT_PUBLIC_PAYMENTS_OPEN=false

# Stripe (from Vercel Marketplace / Dashboard) — never commit real values
# Prefer a restricted secret key with Checkout + Webhooks only.
# STRIPE_SECRET_KEY=sk_test_REPLACE
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Resend free plan (https://resend.com/api-keys) — Marketplace Pro is optional/paid
# RESEND_API_KEY=re_REPLACE
# EMAIL_FROM="2HANDS <onboarding@resend.dev>"
# After verifying 2handswa.com on free Resend:
# EMAIL_FROM="2HANDS <orders@2handswa.com>"
# Inbox for pre-order lead alerts (email + phone). Use your Resend account email while on free sender.
# LEAD_NOTIFY_EMAIL=you@example.com
# Public URL for logo/images in emails (defaults to production Vercel URL; never use localhost)
# EMAIL_ASSET_BASE_URL=https://waterproof-detailing-glove.vercel.app
# Neon (Vercel Marketplace) — stores pre-order email + phone for manual drop texts
# DATABASE_URL=postgresql://…
# CSV export: GET /api/admin/leads?key=…
# LEADS_EXPORT_SECRET=long-random-string
