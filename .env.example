# Public site URL used for sitemap, robots, JSON-LD, and Stripe success/cancel URLs.
# Production currently: https://waterproof-detailing-glove.vercel.app
# When you add a custom domain, update this + the Stripe webhook endpoint URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock | stripe (NEXT_PUBLIC_ required for checkout UI)
PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_PAYMENT_PROVIDER=stripe

# Stripe (from Vercel Marketplace / Dashboard)
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (wire lib/email.ts later)
# RESEND_API_KEY=re_...
