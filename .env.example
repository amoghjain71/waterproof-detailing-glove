# Public site URL used for sitemap, robots, JSON-LD, Origin checks, and Stripe URLs.
# Production currently: https://waterproof-detailing-glove.vercel.app
# When you add a custom domain, update this + the Stripe webhook endpoint URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# mock | stripe
# Server reads PAYMENT_PROVIDER (and NEXT_PUBLIC_ for checkout UI).
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_PAYMENT_PROVIDER=mock

# Set to true only when Stripe Checkout should accept real (or test-mode) pre-orders.
# Until then, production /api/checkout returns 503 "Pre-order payments open soon".
PAYMENTS_OPEN=false

# Stripe (from Vercel Marketplace / Dashboard) — never commit real values
# Prefer a restricted secret key with Checkout + Webhooks only.
# STRIPE_SECRET_KEY=sk_test_REPLACE
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE

# Resend (wire lib/email.ts later)
# RESEND_API_KEY=re_REPLACE
